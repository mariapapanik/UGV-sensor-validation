<?xml version="1.0"?>
<!--
  Husky A200 for Gazebo Fortress (Ignition Gazebo 6) + ROS 2 Humble.
  Kinematic dimensions match Clearpath's husky_description; the body is built
  from primitives so the package has no mesh dependencies.

  Sensors:
    * Wheel encoders: JointStatePublisher system -> wheel angle [rad] and velocity [rad/s]
    * 2D lidar:       gpu_lidar centred (x=0, y=0) on the top plate -> /scan
    * IMU:            at the robot centre (base_link origin)         -> /imu
-->
<robot name="husky" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Dimensions ===================== -->
  <xacro:property name="wheel_radius" value="0.1651"/>
  <xacro:property name="wheel_width"  value="0.1143"/>
  <xacro:property name="wheel_mass"   value="2.637"/>
  <xacro:property name="wheelbase"    value="0.512"/>   <!-- front-rear axle distance -->
  <xacro:property name="track"        value="0.5708"/>  <!-- left-right wheel distance -->

  <xacro:property name="chassis_x"        value="0.86"/>
  <xacro:property name="chassis_y"        value="0.42"/>
  <xacro:property name="chassis_z"        value="0.22"/>
  <xacro:property name="chassis_z_offset" value="0.05"/>  <!-- chassis centre above axle -->
  <xacro:property name="chassis_mass"     value="46.0"/>

  <xacro:property name="top_plate_z"  value="${chassis_z_offset + chassis_z / 2}"/>
  <xacro:property name="lidar_radius" value="0.04"/>
  <xacro:property name="lidar_length" value="0.07"/>
  <!-- Lidar optical centre, relative to base_link (axle height) -->
  <xacro:property name="lidar_z"      value="${top_plate_z + 0.01 + lidar_length / 2}"/>

  <!-- ===================== Materials ===================== -->
  <material name="husky_yellow"><color rgba="0.95 0.75 0.05 1"/></material>
  <material name="dark_grey"><color rgba="0.2 0.2 0.2 1"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>

  <!-- ===================== Links ===================== -->
  <!-- base_footprint: on the ground, below the robot centre -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- base_link: robot centre at axle height -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_z_offset}" rpy="0 0 0"/>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
      <material name="husky_yellow"/>
    </visual>
    <visual>
      <origin xyz="0 0 ${top_plate_z + 0.005}" rpy="0 0 0"/>
      <geometry><box size="0.80 0.57 0.01"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <visual>
      <origin xyz="${chassis_x / 2 + 0.03} 0 ${chassis_z_offset}" rpy="0 0 0"/>
      <geometry><box size="0.06 0.57 0.08"/></geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="${-chassis_x / 2 - 0.03} 0 ${chassis_z_offset}" rpy="0 0 0"/>
      <geometry><box size="0.06 0.57 0.08"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_z_offset}" rpy="0 0 0"/>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${chassis_z_offset}" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia ixx="${chassis_mass / 12 * (chassis_y * chassis_y + chassis_z * chassis_z)}" ixy="0" ixz="0"
               iyy="${chassis_mass / 12 * (chassis_x * chassis_x + chassis_z * chassis_z)}" iyz="0"
               izz="${chassis_mass / 12 * (chassis_x * chassis_x + chassis_y * chassis_y)}"/>
    </inertial>
  </link>

  <!-- ===================== Wheels ===================== -->
  <xacro:macro name="wheel" params="prefix x y">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="${pi / 2} 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass / 12 * (3 * wheel_radius * wheel_radius + wheel_width * wheel_width)}" ixy="0" ixz="0"
                 iyy="${wheel_mass / 12 * (3 * wheel_radius * wheel_radius + wheel_width * wheel_width)}" iyz="0"
                 izz="${wheel_mass / 2 * wheel_radius * wheel_radius}"/>
      </inertial>
    </link>

    <!-- Positive rotation about +y drives the robot forward -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel prefix="front_left"  x="${wheelbase / 2}"  y="${track / 2}"/>
  <xacro:wheel prefix="front_right" x="${wheelbase / 2}"  y="${-track / 2}"/>
  <xacro:wheel prefix="rear_left"   x="${-wheelbase / 2}" y="${track / 2}"/>
  <xacro:wheel prefix="rear_right"  x="${-wheelbase / 2}" y="${-track / 2}"/>

  <!-- ===================== Lidar (centred on top) ===================== -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_length}"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_length}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.17"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${lidar_z}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <!-- frame_id written into the LaserScan header (Fortress tag name) -->
      <ignition_frame_id>lidar_link</ignition_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.10</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
        <!-- Set stddev to 0 for exact ranges -->
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ===================== IMU (robot centre) ===================== -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>imu</topic>
      <ignition_frame_id>imu_link</ignition_frame_id>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <!-- Noise roughly like a consumer MEMS IMU; set stddev to 0 for exact values -->
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ===================== Gazebo systems ===================== -->
  <gazebo>
    <!-- Wheel encoders: publishes every joint's position/velocity -->
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher"/>

    <!-- Skid-steer drive: /cmd_vel in, wheel-encoder odometry out on /odom + /tf -->
    <plugin filename="ignition-gazebo-diff-drive-system"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${track}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>

    <!-- Ground truth pose from the simulator (to check the sensors against) -->
    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>

</robot>
